---
import { App } from '../components/App';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PPKO Biro TI Udinus Kediri 2026 | Melon Presisi AIoT</title>
    <meta name="description" content="PPKO Biro TI Udinus Kediri 2026 mengembangkan pertanian melon presisi berbasis AIoT, fertigasi otomatis, dan pemberdayaan Kelompok Tani Sido Maju di Desa Ngablak." />
    <meta name="keywords" content="PPKO Biro TI Udinus Kediri 2026, PPK Ormawa, melon presisi, AIoT pertanian, fertigasi otomatis, smart farming, Desa Ngablak" />
    <meta name="author" content="PPKO Biro Teknik Informatika Udinus Kediri" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://tirtaruna.site/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content="PPKO Biro TI Udinus Kediri 2026" />
    <meta property="og:description" content="Inovasi pertanian melon presisi berbasis AIoT dan fertigasi otomatis di Desa Ngablak." />
    <meta property="og:url" content="https://tirtaruna.site/" />
    <meta property="og:image" content="https://tirtaruna.site/products/melon_golden_inthanon.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="PPKO Biro TI Udinus Kediri 2026" />
    <meta name="twitter:description" content="Pertanian melon presisi berbasis AIoT dan fertigasi otomatis." />
    <meta name="twitter:image" content="https://tirtaruna.site/products/melon_golden_inthanon.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'PPKO Biro TI Udinus Kediri 2026',
      url: 'https://tirtaruna.site/',
      sameAs: ['https://www.instagram.com/ppk.ormawatikediri/', 'https://www.tiktok.com/@ppk.ormawatikediri'],
      description: 'Program pertanian melon presisi berbasis AIoT dan fertigasi otomatis di Desa Ngablak.'
    })}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.scrollTo(0, 0);
    </script>
  </head>
  <body class="bg-[#FAF7EE] text-[#16381E] antialiased font-['Plus_Jakarta_Sans',sans-serif]">
    <App client:only="react" />
  </body>
</html>
